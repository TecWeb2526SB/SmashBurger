# Configurazione di Apache per il sito.
#
# Tutte le regole usano percorsi relativi alla cartella che contiene questo file, così
# il sito funziona sia servito dalla radice del dominio sia da una sottocartella.

RewriteEngine On

# I file e le cartelle che esistono davvero vengono serviti senza modifiche.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Un indirizzo senza estensione viene servito dal file .php con lo stesso nome.
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([A-Za-z0-9_-]+)$ $1.php [L,QSA]

# Qualsiasi altro indirizzo mostra la pagina 404, che imposta da sola il codice di stato.
# La direttiva ErrorDocument non viene usata perché accetta solo percorsi assoluti,
# che impedirebbero l'installazione in una sottocartella.
RewriteRule ^ errors/404.php [L]

# I file il cui nome inizia con un punto non sono raggiungibili dal web.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
    # Il sito non contiene stili né script inline: la politica non ammette eccezioni.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; object-src 'none'"
</IfModule>
